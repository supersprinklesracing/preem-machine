{
  "name": "@preem-machine/primes",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "bundle": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "mkdir -p dist/apps/primes/.next",
          "cp -r apps/primes/.next/standalone dist/apps/primes/.next/",
          "cp -r apps/primes/.next/static dist/apps/primes/.next/",
          "cp -r apps/primes/public dist/apps/primes/ || true",
          "mkdir -p dist/apps/primes/.next/standalone/apps/primes/.next",
          "cp -r apps/primes/public dist/apps/primes/.next/standalone/apps/primes/ || true",
          "cp -r apps/primes/.next/static dist/apps/primes/.next/standalone/apps/primes/.next/"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "{workspaceRoot}/apps/primes/jest.config.ts",
        "passWithNoTests": true,
        "color": false,
        "colors": false,
        "forceExit": true,
        "detectOpenHandles": true
      },
      "configurations": {
        "node": {
          "jestConfig": "{workspaceRoot}/apps/primes/jest.node.config.ts",
          "outputs": ["{workspaceRoot}/coverage/{projectRoot}-node"]
        }
      }
    }
  }
}
