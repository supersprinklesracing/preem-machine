rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Check if the user is an admin of the specified organization
    function isOrgMember(orgId) {
      let orgDoc = get(/databases/$(database)/documents/organizations/$(orgId));
      let userRef = /databases/$(database)/documents/users/$(request.auth.uid);
      return orgDoc != null && (userRef in orgDoc.data.memberRefs);
    }
    
    match /users/{userId} {
      // Users can only read/write their own profiles
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
    
    match /organizations/{orgId} {
      allow read: if true; // Publicly readable
      allow write: if isAuth() && isOrgMember(orgId);
    }
    
    match /series/{docId} {
      allow read: if true;
      allow update, delete: if isAuth() && isOrgMember(resource.data.organizationId);
      allow create: if isAuth() && isOrgMember(request.resource.data.organizationId);
    }
    
    match /events/{docId} {
      allow read: if true;
      allow update, delete: if isAuth() && isOrgMember(resource.data.organizationId);
      allow create: if isAuth() && isOrgMember(request.resource.data.organizationId);
    }
    
    match /races/{docId} {
      allow read: if true;
      allow update, delete: if isAuth() && isOrgMember(resource.data.organizationId);
      allow create: if isAuth() && isOrgMember(request.resource.data.organizationId);
    }
    
    match /preems/{docId} {
      allow read: if true;
      allow update, delete: if isAuth() && isOrgMember(resource.data.organizationId);
      allow create: if isAuth() && isOrgMember(request.resource.data.organizationId);
    }
    
    match /contributions/{docId} {
      allow read: if true;
      allow update, delete: if isAuth() && isOrgMember(resource.data.organizationId);
      allow create: if isAuth(); 
    }
  }
}
