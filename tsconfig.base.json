{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@preem-machine/source"],
    "baseUrl": ".",
    "paths": {
      "@preem-machine/env": ["libs/env-vars/src/index.ts"],
      "@preem-machine/env/*": ["libs/env-vars/src/*"],
      "@preem-machine/firestore": ["libs/firestore/src/index.ts"],
      "@preem-machine/firestore/*": ["libs/firestore/src/*"],
      "@preem-machine/firestore/server": ["libs/firestore/src/server/index.ts"],
      "@preem-machine/stripe": ["libs/stripe/src/index.ts"],
      "@preem-machine/stripe/*": ["libs/stripe/src/*"]
    }
  }
}
