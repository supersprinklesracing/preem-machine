{
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@preem-machine/source"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@preem-machine/firestore": ["libs/firestore/src/index.ts"],
      "@preem-machine/firestore/*": ["libs/firestore/src/*"],
      "@preem-machine/youtube": ["libs/youtube/src/index.ts"],
      "@preem-machine/youtube/*": ["libs/youtube/src/*"],
      "@preem-machine/squareup": ["libs/squareup/src/index.ts"],
      "@preem-machine/squareup/*": ["libs/squareup/src/*"],
      "@preem-machine/mail": ["libs/mail/src/index.ts"],
      "@preem-machine/mail/*": ["libs/mail/src/*"],
      "@preem-machine/util": ["libs/util/src/index.ts"],
      "@preem-machine/util/*": ["libs/util/src/*"],
      "@preem-machine/jsx": ["libs/jsx/src/index.ts"],
      "@preem-machine/jsx/*": ["libs/jsx/src/*"],
      "@/*": ["apps/web/src/*"],
      "@preem-machine/app": ["./libs/app/src/index.ts"],
      "@preem-machine/chores": ["./libs/chores/src/index.ts"],
      "@preem-machine/chores/*": ["./libs/chores/src/*"],
      "@preem-machine/competitions": ["./libs/competitions/src/index.ts"],
      "@preem-machine/competitions/*": ["./libs/competitions/src/*"],
      "@preem-machine/export-sheets": ["./libs/export-sheets/src/index.ts"],
      "@preem-machine/export-sheets/*": ["./libs/export-sheets/src/*"],
      "@preem-machine/ghost": ["libs/ghost/src/index.ts"],
      "@preem-machine/logging": ["libs/logging/src/index.ts"],
      "@preem-machine/logging/browser": ["libs/logging/src/browser/index.ts"],
      "@preem-machine/logging/server": ["libs/logging/src/server/index.ts"],
      "@preem-machine/provider-service": [
        "./libs/provider-service/src/index.ts"
      ],
      "@preem-machine/provider-service/*": ["./libs/provider-service/src/*"],
      "@preem-machine/qbp": ["./libs/qbp/src/index.ts"],
      "@preem-machine/qbp/*": ["./libs/qbp/src/*"],
      "@preem-machine/race-events": ["./libs/race-events/src/index.ts"],
      "@preem-machine/race-events/*": ["./libs/race-events/src/*"],
      "@preem-machine/races": ["./libs/races/src/index.ts"],
      "@preem-machine/races/*": ["./libs/races/src/*"],
      "@preem-machine/strava": ["./libs/strava/src/index.ts"],
      "@preem-machine/strava/*": ["./libs/strava/src/*"],
      "@preem-machine/service-auth": ["libs/service-auth/src/index.ts"],
      "@preem-machine/service-auth/*": ["libs/service-auth/src/*"],
      "@preem-machine/test-utils": ["libs/test-utils/src/index.ts"],
      "@preem-machine/test-utils/*": ["libs/test-utils/src/*"],
      "@preem-machine/auth": ["libs/auth/src/index.ts"],
      "@preem-machine/auth/server": ["libs/auth/src/server/index.ts"],
      "@preem-machine/auth/client": ["libs/auth/src/client/index.ts"],
      "@preem-machine/cloudevents": ["libs/cloudevents/src/index.ts"],
      "@preem-machine/env": ["libs/env-vars/src/index.ts"],
      "@preem-machine/env/*": ["libs/env-vars/src/*"],
      "@preem-machine/stripe": ["libs/stripe/src/index.ts"],
      "@preem-machine/stripe/*": ["libs/stripe/src/*"],
      "@preem-machine/secrets": ["libs/secrets/src/index.ts"],
      "@preem-machine/workspace-plugin": [
        "./tools/workspace-plugin/src/index.ts"
      ],
      "@preem-machine/firebase-server": ["libs/firebase-server/src/index.ts"],
      "@preem-machine/instagram": ["libs/instagram/src/index.ts"],
      "@preem-machine/google": ["libs/google/src/index.ts"],
      "@preem-machine/rag": ["libs/rag/src/index.ts"],
      "@preem-machine/rag/*": ["libs/rag/src/*"],
      "@preem-machine/results": ["./libs/results/src/index.ts"],
      "@preem-machine/results/*": ["./libs/results/src/*"],
      "@preem-machine/riders": ["./libs/riders/src/index.ts"],
      "@preem-machine/riders/*": ["./libs/riders/src/*"],
      "@preem-machine/slack": ["./libs/slack/src/index.ts"],
      "@preem-machine/slack/*": ["./libs/slack/src/*"],
      "@preem-machine/assistant": ["libs/assistant/src/index.ts"],
      "@preem-machine/dummy": ["./dummy/src/index.ts"],
      "@preem-machine/dummy2": ["./dummy2/src/index.ts"],
      "@preem-machine/util-server": ["libs/util-server/src/index.ts"],
      "@preem-machine/util-server/*": ["libs/util-server/src/*"],
      "@preem-machine/cli/*": ["apps/cli/src/*"]
    }
  }
}
